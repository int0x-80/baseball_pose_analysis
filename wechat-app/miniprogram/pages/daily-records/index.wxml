<view class="daily-container">
  <!-- 日期标题 -->
  <view class="date-header">
    <text class="date-text">{{date}}</text>
    <text class="count-text">共 {{records.length}} 条记录</text>
  </view>

  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:elif="{{records.length === 0}}">
    <text class="empty-icon">📋</text>
    <text class="empty-text">当天暂无训练记录</text>
  </view>

  <!-- 记录列表 -->
  <view class="records-list" wx:else>
    <view
      class="record-card card"
      wx:for="{{records}}"
      wx:key="recordId"
      bindtap="viewDetail"
      data-id="{{item.recordId}}"
    >
      <view class="record-top">
        <text class="record-type">{{item.type === 'batting' ? '🏏 击球' : '⚾ 投球'}}</text>
        <text class="status-tag status-{{item.status}}">{{item.statusText}}</text>
        <text class="record-time">{{item.timeText}}</text>
      </view>

      <view class="record-body" wx:if="{{item.status === 1}}">
        <view class="stat-chips">
          <text class="chip" wx:if="{{item.maxBatSpeedKmH}}">棒速 {{item.maxBatSpeedKmH}} km/h</text>
          <text class="chip" wx:if="{{item.leftSpeedMs}}">左手 {{item.leftSpeedMs}} m/s</text>
          <text class="chip" wx:if="{{item.rightSpeedMs}}">右手 {{item.rightSpeedMs}} m/s</text>
          <text class="chip" wx:if="{{item.maxHipRotationMm}}">转胯 {{item.maxHipRotationMm}} mm</text>
          <text class="chip" wx:if="{{item.maxTwistAngleDeg}}">扭转 {{item.maxTwistAngleDeg}}°</text>
        </view>
      </view>

      <view class="record-bottom">
        <text class="detail-link">查看详情 →</text>
      </view>
    </view>
  </view>
</view>
