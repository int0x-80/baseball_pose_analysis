<view class="login-page">
  <view class="login-header">
    <text class="title">棒球动作分析</text>
    <text class="subtitle">专业的棒球动作分析系统</text>
  </view>

  <view class="login-card">
    <!-- 手机号 -->
    <view class="form-group">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" maxlength="11"
        placeholder="请输入手机号" value="{{phone}}" bindinput="onPhoneInput" />
    </view>

    <!-- 验证码 -->
    <view class="form-group">
      <text class="form-label">验证码</text>
      <view class="code-row">
        <input class="form-input code-input" type="number" maxlength="6"
          placeholder="请输入验证码" value="{{code}}" bindinput="onCodeInput" />
        <button class="code-btn" disabled="{{codeSending}}" bindtap="sendCode">
          {{codeSending ? countdown + 's' : '获取验证码'}}
        </button>
      </view>
    </view>

    <!-- 登录按钮 -->
    <button class="btn-primary" loading="{{loading}}" bindtap="phoneLogin">登录</button>

    <!-- 微信登录 -->
    <button class="btn-wechat" open-type="getPhoneNumber" bindgetphonenumber="wechatLogin">
      微信一键登录
    </button>

    <!-- 注册链接 -->
    <view class="link-row">
      <text>还没有账号？</text>
      <text class="link" bindtap="goToRegister">立即注册</text>
    </view>
  </view>
</view>
