<view class="register-container">
  <view class="register-header">
    <view class="back-btn" bindtap="goBack">
      <text class="back-icon">←</text>
    </view>
    <text class="header-title">用户注册</text>
  </view>

  <view class="register-card">
    <view class="form-group">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhoneInput" />
    </view>

    <view class="form-group">
      <text class="form-label">验证码</text>
      <view class="code-row">
        <input class="form-input code-input" type="number" maxlength="6" placeholder="请输入验证码" value="{{code}}" bindinput="onCodeInput" />
        <view class="code-btn {{codeSending ? 'disabled' : ''}}" bindtap="sendCode">
          <text>{{codeSending ? countdown + 's' : '获取验证码'}}</text>
        </view>
      </view>
    </view>

    <view class="form-group">
      <text class="form-label">昵称</text>
      <input class="form-input" maxlength="20" placeholder="请输入昵称" value="{{nickname}}" bindinput="onNicknameInput" />
    </view>

    <view class="form-group">
      <text class="form-label">密码</text>
      <input class="form-input" password maxlength="20" placeholder="请输入密码（6-20位）" value="{{password}}" bindinput="onPasswordInput" />
    </view>

    <view class="form-group">
      <text class="form-label">性别</text>
      <view class="gender-row">
        <view class="gender-item {{gender === 0 ? 'active' : ''}}" bindtap="selectGender" data-value="0">未知</view>
        <view class="gender-item {{gender === 1 ? 'active' : ''}}" bindtap="selectGender" data-value="1">男</view>
        <view class="gender-item {{gender === 2 ? 'active' : ''}}" bindtap="selectGender" data-value="2">女</view>
      </view>
    </view>

    <view class="btn-primary register-btn" bindtap="doRegister">
      <text>{{loading ? '注册中...' : '注册'}}</text>
    </view>

    <view class="login-link">
      <text>已有账号？</text>
      <text class="link" bindtap="goToLogin">立即登录</text>
    </view>
  </view>
</view>
