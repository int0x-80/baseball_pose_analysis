.calendar-page {
  min-height: 100vh;
  background: #f5f7fa;
  padding: 24rpx;
  padding-bottom: 40rpx;
  position: relative;
}

/* 月份导航 */
.month-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: white;
  border-radius: 16rpx;
  padding: 20rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.month-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border-radius: 50%;
}

.arrow {
  font-size: 36rpx;
  color: #667eea;
  font-weight: bold;
}

.month-label {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

/* 星期 */
.weekdays {
  display: flex;
  margin-bottom: 12rpx;
}

.weekday {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #999;
  padding: 8rpx 0;
}

/* 日历网格 */
.calendar-grid {
  display: flex;
  flex-wrap: wrap;
  background: white;
  border-radius: 16rpx;
  padding: 16rpx 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.day-cell {
  width: calc(100% / 7);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 0;
  position: relative;
}

.day-num {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 50%;
  color: #333;
}

.other-month .day-num {
  color: #ddd;
}

.today .day-num {
  background: #e6f7ff;
  color: #1890ff;
  border: 2rpx solid #1890ff;
}

.records-1 .day-num {
  background: #dff5d7;
  color: #388e3c;
}

.records-2 .day-num {
  background: #a3d98e;
  color: #2e7d32;
}

.records-3 .day-num {
  background: #66bb6a;
  color: white;
}

.records-many .day-num {
  background: #2e7d32;
  color: white;
}

.selected .day-num {
  background: #667eea !important;
  color: white !important;
  border: none;
}

.dot-row {
  margin-top: 4rpx;
}

.dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #66bb6a;
}

/* 图例 */
.legend {
  margin-top: 28rpx;
  background: white;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.legend-title {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
  display: block;
}

.legend-items {
  display: flex;
  gap: 24rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #666;
}

.legend-box {
  width: 28rpx;
  height: 28rpx;
  border-radius: 6rpx;
}

/* 选中日期信息 */
.selected-info {
  margin-top: 24rpx;
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.selected-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* 加载遮罩 */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  font-size: 28rpx;
  color: #999;
}
