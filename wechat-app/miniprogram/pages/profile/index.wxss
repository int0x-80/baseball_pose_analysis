.profile-container {
  min-height: 100vh;
  background: #f5f7fa;
}

.profile-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 48rpx 32rpx 40rpx;
}

.avatar-area {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
}

.avatar-default {
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: white;
  font-weight: bold;
}

.user-meta {
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 34rpx;
  color: white;
  font-weight: 600;
}

.user-id {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 6rpx;
}

/* 统计 */
.stats-row {
  display: flex;
  background: white;
  margin: -20rpx 24rpx 24rpx;
  border-radius: 16rpx;
  padding: 28rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  position: relative;
  z-index: 1;
}

.stat-item {
  flex: 1;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.stat-val {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.stat-lbl {
  font-size: 22rpx;
  color: #999;
}

/* 菜单 */
.menu-section {
  margin: 0 24rpx 24rpx;
  padding: 0;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.menu-arrow {
  font-size: 32rpx;
  color: #ccc;
}

/* 退出按钮 */
.logout-btn {
  margin: 40rpx 24rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: 28rpx;
  color: #f56c6c;
  border-color: #f56c6c;
  border-radius: 16rpx;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-content {
  width: 85%;
  background: white;
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  margin-bottom: 28rpx;
  display: block;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.modal-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 28rpx;
  border-radius: 12rpx;
}

.gender-row {
  display: flex;
  gap: 16rpx;
}

.gender-item {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  border: 2rpx solid #e8e8e8;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #666;
}

.gender-item.active {
  border-color: #667eea;
  color: #667eea;
  background: rgba(102, 126, 234, 0.08);
}

/* 积分弹窗 */
.points-modal {
  max-height: 70vh;
}

.points-list {
  max-height: 50vh;
  overflow-y: auto;
}

.points-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.points-item:last-child {
  border-bottom: none;
}

.points-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.points-desc {
  font-size: 26rpx;
  color: #333;
}

.points-time {
  font-size: 22rpx;
  color: #999;
}

.points-amount {
  font-size: 30rpx;
  font-weight: 600;
}

.points-amount.positive {
  color: #52c41a;
}

.points-amount.negative {
  color: #f56c6c;
}
